<script type="module">
import * as THREE from 'three';

// ==================== CONFIG ====================
const CONFIG = {
  mapSize: 80,
  playerSpeed: 5,
  playerRunSpeed: 9,
  playerRadius: 0.4,
  interactDistance: 4,
  feedDistance: 3,
  cameraMinDist: 3,
  cameraMaxDist: 10,
  cameraDefaultDist: 7,
  cameraPitchMin: -10 * Math.PI / 180,
  cameraPitchMax: 70 * Math.PI / 180,
  cameraSmoothSpeed: 8,
  cameraRotateSpeed: 0.003,
  cameraZoomSpeed: 0.5,
  crops: {
    wortel:  { name:'Wortel',  growTime:20,  buyPrice:3,  sell:{biasa:5,rainbow:60,petir:40,batu:20} },
    gandum:  { name:'Gandum',  growTime:20,  buyPrice:3,  sell:{biasa:5,rainbow:60,petir:40,batu:20} },
    jagung:  { name:'Jagung',  growTime:40,  buyPrice:6,  sell:{biasa:15,rainbow:80,petir:60,batu:40} },
    kentang: { name:'Kentang', growTime:60,  buyPrice:10, sell:{biasa:15,rainbow:100,petir:70,batu:50} },
    pisang:  { name:'Pisang',  growTime:90,  buyPrice:15, sell:{biasa:25,rainbow:125,petir:100,batu:70} },
    cabai:   { name:'Cabai',   growTime:120, buyPrice:20, sell:{biasa:35,rainbow:135,petir:110,batu:80} }
  },
  mutChanceNormal: 0.65,
  mutChanceRainbow: 0.05,
  mutChancePetir: 0.10,
  mutChanceBatu: 0.20,
  skinApi:  { name:'Skin Api',  price:2000, luck:0.10 },
  skinDaun: { name:'Skin Daun', price:2500, luck:0.15 },
  chickenPrice: 200,
  cowPrice: 300,
  maxAnimals: 3,
  productionTime: 120, // 2 menit (120 dtk)
  eggSellPrice: 5,
  milkSellPrice: 10,
  xpPerLevel: 100,
  maxLevel: 30,
  xpSiram: 5,
  xpPanen: 10,
  plotUpgrades: [
    { level:10, price:500, plots:2 },
    { level:15, price:800, plots:2 },
    { level:20, price:1000, plots:2 }
  ],
  bucketCapacity: 5,
  housePos: { x:0, z:0 },
  wellPos: { x:7, z:5 },
  chickenPenPos: { x:-12, z:-2 },
  cowPenPos: { x:12, z:-2 },
  shopPos: {
    bibit:   { x:-9, z:15 },
    jualTan: { x:-3, z:15 },
    hewan:   { x:3,  z:15 },
    jualTer: { x:9,  z:15 }
  },
  plotStartX: -3,
  plotStartZ: 7,
  plotSpacing: 2,
  penSize: 7,
  animalSpeed: 0.5
};

// ==================== STATE ====================
const state = {
  coins: 10,
  level: 1,
  xp: 0,
  bucket: { water: 5 },
  bucketSkin: null, // null | 'api' | 'daun'
  inventory: {
    bibit: { wortel:2, gandum:0, jagung:0, kentang:0, pisang:0, cabai:0 },
    panen: {},
    ternak: { telur:0, susu:0 },
    skins: { api:false, daun:false }
  },
  hotbarSelected: 0,
  plotUpgradeLevel: 0, // 0 = 4 plots, 1 = 6 plots, 2 = 8 plots, 3 = 10 plots
  plots: [],
  animals: [],
  panelOpen: null
};

// ==================== SAVE / LOAD ====================
function saveGame() {
  try {
    const saveData = {
      coins: state.coins,
      level: state.level,
      xp: state.xp,
      bucket: state.bucket,
      bucketSkin: state.bucketSkin,
      inventory: state.inventory,
      plotUpgradeLevel: state.plotUpgradeLevel,
      animalCount: state.animals.length,
      animals: state.animals.map(a => ({
        type: a.type,
        producing: a.producing,
        productReady: a.productReady,
        productTimer: a.productTimer
      }))
    };
    localStorage.setItem('plant_it_save', JSON.stringify(saveData));
  } catch (e) {
    // ignore
  }
}

function loadGame() {
  try {
    const raw = localStorage.getItem('plant_it_save');
    if (!raw) return;
    const d = JSON.parse(raw);
    if (d.coins !== undefined) state.coins = d.coins;
    if (d.level !== undefined) state.level = d.level;
    if (d.xp !== undefined) state.xp = d.xp;
    if (d.bucket) state.bucket = d.bucket;
    if (d.bucketSkin !== undefined) state.bucketSkin = d.bucketSkin;
    if (d.inventory) {
      if (d.inventory.bibit) state.inventory.bibit = { ...state.inventory.bibit, ...d.inventory.bibit };
      if (d.inventory.panen) state.inventory.panen = { ...state.inventory.panen, ...d.inventory.panen };
      if (d.inventory.ternak) state.inventory.ternak = { ...state.inventory.ternak, ...d.inventory.ternak };
      if (d.inventory.skins) state.inventory.skins = { ...state.inventory.skins, ...d.inventory.skins };
    }
    if (d.plotUpgradeLevel !== undefined) {
      const targetLevel = d.plotUpgradeLevel;
      for (let i = state.plotUpgradeLevel; i < targetLevel; i++) {
        if (i === 0) { createSinglePlot(-3, 9.5, 4, false); createSinglePlot(-1, 9.5, 5, false); }
        else if (i === 1) { createSinglePlot(1, 9.5, 6, false); createSinglePlot(3, 9.5, 7, false); }
        else if (i === 2) { createSinglePlot(-2, 12, 8, false); createSinglePlot(2, 12, 9, false); }
        state.plotUpgradeLevel = i + 1;
      }
    }
    if (Array.isArray(d.animals) && d.animals.length > 1) {
      for (let i = 1; i < d.animals.length; i++) {
        const savedA = d.animals[i];
        if (savedA.type === 'ayam') {
          createChicken(CONFIG.chickenPenPos.x + (Math.random() - 0.5) * 2, CONFIG.chickenPenPos.z + (Math.random() - 0.5) * 2);
        } else if (savedA.type === 'sapi') {
          createCow(CONFIG.cowPenPos.x + (Math.random() - 0.5) * 2, CONFIG.cowPenPos.z + (Math.random() - 0.5) * 2);
        }
      }
    }
  } catch (e) {
    console.error('Gagal memuat save game:', e);
  }
}

// ==================== UTILITIES ====================
const colliders = [];
const interactables = [];
const _v3a = new THREE.Vector3();
const _v3b = new THREE.Vector3();
const _v3c = new THREE.Vector3();
const _v3d = new THREE.Vector3();

function distXZ(a, b) {
  const ax = a.x !== undefined ? a.x : a.position ? a.position.x : 0;
  const az = a.z !== undefined ? a.z : a.position ? a.position.z : 0;
  const bx = b.x !== undefined ? b.x : b.position ? b.position.x : 0;
  const bz = b.z !== undefined ? b.z : b.position ? b.position.z : 0;
  return Math.sqrt((ax - bx) ** 2 + (az - bz) ** 2);
}

function lerpAngle(a, b, t) {
  let d = b - a;
  while (d > Math.PI) d -= Math.PI * 2;
  while (d < -Math.PI) d += Math.PI * 2;
  return a + d * Math.min(t, 1);
}

function createCanvasTex(w, h, fn) {
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  fn(c.getContext('2d'), w, h);
  const t = new THREE.CanvasTexture(c);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}

function grassTex() {
  const t = createCanvasTex(512, 512, (ctx, w, h) => {
    ctx.fillStyle = '#4a8c3f'; ctx.fillRect(0, 0, w, h);
    for (let i = 0; i < 6000; i++) {
      const g = 80 + Math.random() * 60;
      ctx.fillStyle = `rgb(${g - 20},${g + 30},${g - 30})`;
      ctx.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 3, 1 + Math.random() * 3);
    }
  });
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(24, 24);
  return t;
}

function dirtTex() {
  return createCanvasTex(256, 256, (ctx, w, h) => {
    ctx.fillStyle = '#8B6914'; ctx.fillRect(0, 0, w, h);
    for (let i = 0; i < 2000; i++) {
      const v = Math.random() * 30;
      ctx.fillStyle = `rgb(${120 + v},${85 + v},${20 + v})`;
      ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2);
    }
  });
}

function cowTexture() {
  return createCanvasTex(256, 256, (ctx, w, h) => {
    ctx.fillStyle = '#FAFAFA';
    ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = '#212121';
